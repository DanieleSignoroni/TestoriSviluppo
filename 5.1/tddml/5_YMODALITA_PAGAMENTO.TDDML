<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE TDDML SYSTEM "../../../TDDML.dtd">
<TDDML>
  <!-- YMODALITA_PAGAMENTO (YMODALI): Modalità di Pagamento Primrose; -->
  <CreateTable schema="THIPPERS" name="YMODALITA_PAGAMENTO" shortname="YMODALI">
    <Column name="T01CD" shortname="T01CD" type="char" length="3" nullable="no"/>
    <Column name="T22CD" shortname="T22CD" type="char" length="3" nullable="no"/>
    <Column name="R_BLOCCO_EVASIONE" shortname="R_BLOCCO_E" type="char" length="3" nullable="yes"/>
    <Column name="R_BLOCCO_PIANIFICAZIONE" shortname="R_BLOCCO_P" type="char" length="3" nullable="yes"/>
  </CreateTable>
  <CreateIndex schema="THIPPERS" name="YMODALITA_PAGA_I01" tabschema="THIPPERS" tabname="YMODALITA_PAGAMENTO" shortname="YMODAL_I01" unique="yes">
    <IndexCol name="T01CD" order="Asc"/>
    <IndexCol name="T22CD" order="Asc"/>
  </CreateIndex>
  <AlterTable schema="THIPPERS" name="YMODALITA_PAGAMENTO">
    <AddPrimaryKey>
      <PrimaryKey>
        <ColumnRef name="T01CD"/>
        <ColumnRef name="T22CD"/>
      </PrimaryKey>
    </AddPrimaryKey>
  </AlterTable>
  <Comment>
    <CommentTable schema="THIPPERS" name="YMODALITA_PAGAMENTO" text="Modalità di Pagamento Primrose">
      <CommentColumn name="T01CD" text="Codice Azienda"/>
      <CommentColumn name="T22CD" text="Codice"/>
      <CommentColumn name="R_BLOCCO_EVASIONE" text="Blocco evasione ordine"/>
      <CommentColumn name="R_BLOCCO_PIANIFICAZIONE" text="Motivo blocco pianificazione"/>
    </CommentTable>
    <CommentIndex schema="THIPPERS" name="YMODALITA_PAGA_I01" text="Primary Key"/>
  </Comment>
  <Grant schema="THIPPERS" name="YMODALITA_PAGAMENTO"/>
</TDDML>
